{
	"name": "names-on-chain",
	"version": "0.0.5",
	"private": true,
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=20"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter \"./apps/*\" build",
		"check": "pnpm -r check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm run test:unit && pnpm run test:integration",
		"test:unit": "pnpm -r test:unit",
		"test:integration": "pnpm -r --filter \"./apps/*\" --workspace-concurrency=1 test:integration",
		"start-state": "node scripts/start-state.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^8.57.1",
		"@types/eslint": "^8.56.12",
		"@types/node": "^22.20.4",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^3.5.2",
		"typescript": "^5.9.3"
	}
}
